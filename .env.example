# Copy to .env (or .env.development / .env.production) and adjust.
# Vite restarts are needed after changing these.

# ---- Browser (baked into the build) ----
# Base URL the app calls for the API, including the /api path.
# Leave unset when the server hosts the web app (same domain) or in dev (the proxy below handles it).
# If the web app is on a different domain, also set CORS_ORIGIN in server/.env.
# VITE_API_URL=https://api.example.com/api

# ---- Dev server only (never sent to the browser) ----
# Where `npm run dev` forwards /api requests
API_PROXY_TARGET=http://localhost:4000
WEB_PORT=5173
